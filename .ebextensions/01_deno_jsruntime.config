# yt-dlp needs a JavaScript runtime to solve YouTube's signature challenges.
# Without one it silently degrades to the android_vr client, which YouTube
# starts refusing after a few minutes. Node is reported as unsupported, so
# install Deno (yt-dlp's default runtime).
#
# On a Graviton (arm64) instance swap the archive for
# deno-aarch64-unknown-linux-gnu.zip.
packages:
  yum:
    unzip: []
    python3.11: []

commands:
  01-deno-download:
    command: "curl -fsSL -o /tmp/deno.zip https://github.com/denoland/deno/releases/latest/download/deno-x86_64-unknown-linux-gnu.zip"
  02-deno-install:
    command: "unzip -oq /tmp/deno.zip -d /usr/local/bin && chmod +x /usr/local/bin/deno"
  03-deno-verify:
    command: "/usr/local/bin/deno --version"
  # Amazon Linux 2023 defaults to python3.9; the yt-dlp zipapp requires 3.10+.
  04-python:
    command: "ln -sf /usr/bin/python3.11 /usr/local/bin/python3"

option_settings:
  aws:elasticbeanstalk:application:environment:
    # yt-dlp caches solved signature functions here. Must be writable by the
    # app user or the player JS is re-solved on every request.
    XDG_CACHE_HOME: /tmp/yt-dlp-cache
